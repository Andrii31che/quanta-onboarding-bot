# ── Quanta онбординг-бот — переменные окружения ──────────────────────────────
# Скопируй в .env (локально):  cp env.example .env
# На проде — внеси значения в Railway → Variables.
# .env гитигнорится — реальные значения в репозиторий НЕ попадают.

# ОБЯЗАТЕЛЬНО ───────────────────────────────────────────────────────────────
# Токен бота из Discord Developer Portal → твоё приложение → Bot → Reset Token.
DISCORD_TOKEN=

# РЕКОМЕНДУЕТСЯ (на проде) ────────────────────────────────────────────────────
# ID сервера Quanta (вкл. Developer Mode в Discord → ПКМ по серверу → Copy ID).
GUILD_ID=

# SETUP_MODE ──────────────────────────────────────────────────────────────────
# 1 = при старте бот один раз собирает сервер по спеке §3-§6: роли, каналы
# с тирами записи, грандфазер @member, якоря в #старт (ID печатает в лог).
# После успешного прогона вернуть в 0 / убрать.
SETUP_MODE=0

# ЯКОРНЫЕ СООБЩЕНИЯ в #старт (печатает setup в лог; или ПКМ → Copy Message ID)
# Сообщение с правилами (реакция ✅ = принятие правил):
RULES_MESSAGE_ID=
# Сообщение выбора языка (под ним реакции 🇷🇺🇺🇦🇬🇧):
LANG_MESSAGE_ID=
# Сообщение выбора целей (под ним реакции 💰🏢🚀🧠👀, можно несколько):
GOALS_MESSAGE_ID=

# РОЛИ — имена должны СОВПАДАТЬ с ролями на сервере (создаёт setup) ───────────
NEWCOMER_ROLE=newcomer
MEMBER_ROLE=member
AFFILIATE_ROLE=affiliate
HELPER_ROLE=helper
AMBASSADOR_ROLE=ambassador

# Существующие КОМАНДНЫЕ роли через запятую (спека §3 «как есть») — setup даст
# им запись в #анонсы/#поддержка/#обучение и доступ в #заявки. Пусто = команда
# полагается на право Administrator.
TEAM_ROLES=

# КАНАЛЫ (имена на русском, спека §4; без #) ──────────────────────────────────
START_CHANNEL=старт
APPLICATIONS_CHANNEL=заявки
EARN_CHANNEL=заработок
GENERAL_CHANNEL=общее
LEARN_CHANNEL=обучение
WINS_CHANNEL=результаты
QUESTIONS_CHANNEL=вопросы

# ССЫЛКА для value-DM цели 🚀 («глянь, что она умеет») ────────────────────────
# Пока нет — оставь пустым, бот подставит заглушку «ссылку пришлю отдельно».
PRODUCT_URL=

# ПРОЧЕЕ ───────────────────────────────────────────────────────────────────────
# Через сколько часов слать 1 напоминание не прошедшим онбординг:
REMINDER_HOURS=24
# user-id админов через запятую (Copy ID по пользователю); могут !affiliate/!stats:
ADMIN_IDS=
