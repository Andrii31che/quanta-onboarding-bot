# ── Quanta онбординг-бот — переменные окружения ──────────────────────────────
# Скопируй в .env (локально):  cp env.example .env
# На проде — внеси значения в Railway → Variables.
# .env гитигнорится — реальные значения в репозиторий НЕ попадают.

# ОБЯЗАТЕЛЬНО ───────────────────────────────────────────────────────────────
# Токен бота из Discord Developer Portal → твоё приложение → Bot → Reset Token.
DISCORD_TOKEN=

# РЕКОМЕНДУЕТСЯ (на проде) ────────────────────────────────────────────────────
# ID сервера Quanta (вкл. Developer Mode в Discord → ПКМ по серверу → Copy ID).
GUILD_ID=

# ЯКОРНЫЕ СООБЩЕНИЯ в #start-here (ПКМ по сообщению → Copy Message ID) ─────────
# Сообщение с правилами (реакция ✅ = принятие правил):
RULES_MESSAGE_ID=
# Сообщение выбора сегмента (под ним реакции 🎨💼🚀📱👀):
SEGMENT_MESSAGE_ID=
# Сообщение выбора языка (под ним реакции 🇷🇺🇺🇦🇬🇧):
LANG_MESSAGE_ID=

# РОЛИ — имена должны СОВПАДАТЬ с ролями на сервере (создаёт owner, GROWTH-4) ─
NEWCOMER_ROLE=newcomer
MEMBER_ROLE=member
AFFILIATE_ROLE=affiliate
HELPER_ROLE=helper

# Опц. роли-теги сегментов (если создашь — бот их выдаст; нет — пропустит)
ROLE_CREATOR=seg-creator
ROLE_EXPERT=seg-expert
ROLE_ENTREPRENEUR=seg-entrepreneur
ROLE_BLOGGER=seg-blogger
ROLE_WATCHER=seg-watcher

# КАНАЛ ───────────────────────────────────────────────────────────────────────
START_HERE_CHANNEL=start-here

# ССЫЛКИ для value-DM (пока нет — оставь пустым, бот подставит заглушку) ────────
DEMO_URL=
QLAB_URL=

# ПРОЧЕЕ ───────────────────────────────────────────────────────────────────────
# Через сколько часов слать 1 напоминание не прошедшим онбординг:
REMINDER_HOURS=24
# user-id админов через запятую (Copy ID по пользователю); могут !affiliate/!stats:
ADMIN_IDS=
